{
  "version": 4,
  "purpose": "Second-layer geographic expansion from the live 598-region map. Existing simulated land is subtracted before new regions are created, so already-covered countries are never duplicated.",
  "targetExistingRegionCount": 598,
  "appendOnlyCountriesWhenRebased": [
    "CHE"
  ],
  "principles": [
    "Modern borders are geometry sources, not historical political borders.",
    "Absorb modern microstates unless physical geography independently justifies a standalone region.",
    "Keep Gibraltar and other strategic islands/peninsulas standalone where geography warrants it.",
    "Stop Russia at the Urals for this tranche; Siberia belongs to a later world expansion.",
    "Give productive coasts, river basins, mountain corridors and chokepoints more detail than sparsely populated desert.",
    "Prefer a moderate number of durable geographic regions over reproducing every modern province."
  ],
  "microstateAbsorption": [
    {
      "iso": "VAT",
      "name": "Vatican City",
      "action": "absorb-nearest",
      "reason": "urban enclave inside Rome; future holy-city sovereignty belongs to settlement/politics systems"
    },
    {
      "iso": "SMR",
      "name": "San Marino",
      "action": "absorb-nearest",
      "reason": "small inland enclave without independent strategic geography at this map scale"
    },
    {
      "iso": "MCO",
      "name": "Monaco",
      "action": "absorb-nearest",
      "reason": "urban coastal enclave; no terrain-scale separation"
    },
    {
      "iso": "LIE",
      "name": "Liechtenstein",
      "action": "absorb-swiss-cluster",
      "reason": "Rhine/Alpine territory should merge into the eastern Swiss gameplay region rather than form a detached microstate component"
    }
  ],
  "standaloneExceptions": [
    {
      "name": "Gibraltar",
      "reason": "isolated fortified peninsula controlling a major maritime chokepoint"
    },
    {
      "iso": "AND",
      "name": "Andorra",
      "reason": "high Pyrenean basin; geography can justify a distinct mountain region even without modern-state determinism"
    }
  ],
